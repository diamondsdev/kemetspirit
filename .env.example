# ==============================================================================
# Kemet Spirit — Environment Configuration
# ==============================================================================
# Copy this file to .env in your environment or set these variables in your
# Hostinger Node.js Application -> "Environment variables" settings panel.

# ------------------------------------------------------------------------------
# 1. Supabase PostgreSQL Configuration (Server-Side Authoritative Connection)
# ------------------------------------------------------------------------------
# In Hostinger, these must be set so the Express backend can connect to Supabase.
# NEVER expose the service role key to the browser or commit real keys to Git.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ------------------------------------------------------------------------------
# 2. Initial Administrative Owner Setup Secret
# ------------------------------------------------------------------------------
# High-entropy secret used for the one-time atomic owner account creation
# via POST /api/admin/setup-owner. Must be kept private.
SETUP_SECRET=your-random-high-entropy-secret-minimum-16-characters

# ------------------------------------------------------------------------------
# 3. Google Gemini AI API Key (Optional)
# ------------------------------------------------------------------------------
# Required for server-side Scribe Oracle AI tour assistant and recommendations
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 4. Server Runtime Configuration
# ------------------------------------------------------------------------------
# On Hostinger Node.js hosting (Phusion Passenger), PORT is automatically assigned
# as either an integer or a Unix domain socket path (e.g., /tmp/passenger.xxx).
# For local development or non-Passenger VPS, set PORT=3000.
PORT=3000
NODE_ENV=production