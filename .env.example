# Supabase Configuration (Server-Side Authoritative PostgreSQL Connection ONLY)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Initial staff owner provisioning secret (Must be a high-entropy secret, required for setup)
SETUP_SECRET=your-random-high-entropy-secret

# Google Gemini API Key for server-side Scribe Oracle AI planner
GEMINI_API_KEY=

# Server Runtime
PORT=3000
NODE_ENV=development